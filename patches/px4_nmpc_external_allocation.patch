+bool Standard::externalAllocationEligible() const
+{
+	return _param_vt_ext_alloc_en.get()
+	       && _v_control_mode->flag_armed
+	       && _v_control_mode->flag_control_offboard_enabled
+	       && _v_control_mode->flag_control_rates_enabled;
+}
+
+float Standard::externalAllocationWeight()
+{
+	const hrt_abstime now = hrt_absolute_time();
+	vtol_nmpc_allocation_setpoint_s setpoint{};
+
+	if (_external_allocation_setpoint_sub.update(&setpoint)) {
+		_external_allocation_timestamp_sample = setpoint.timestamp;
+		_last_time_external_allocation_setpoint = now;
+		_external_allocation_setpoint_valid = PX4_ISFINITE(setpoint.transition_weight)
+				&& setpoint.transition_weight >= 0.0f
+				&& setpoint.transition_weight <= 1.0f;
+
+		if (_external_allocation_setpoint_valid) {
+			_external_allocation_requested = setpoint.transition_weight;
+		}
+	}
+
+	const bool fresh = _last_time_external_allocation_setpoint != 0
+			   && hrt_elapsed_time(&_last_time_external_allocation_setpoint) <= 200_ms;
+	_external_allocation_active = externalAllocationEligible()
+				      && fresh
+				      && _external_allocation_setpoint_valid;
+
+	if (!externalAllocationEligible()) {
+		_external_allocation_weight.setForcedValue(1.0f);
+		_last_time_external_allocation_update = now;
+
+	} else {
+		const float target = _external_allocation_active
+				     ? _external_allocation_requested
+				     : 1.0f;
+		const float dt = math::constrain(
+				 (now - _last_time_external_allocation_update) * 1e-6f,
+				 0.0f,
+				 0.05f);
+		_last_time_external_allocation_update = now;
+		_external_allocation_weight.update(target, dt);
+	}
+
+	vtol_nmpc_allocation_status_s status{};
+	status.timestamp = now;
+	status.timestamp_sample = _external_allocation_timestamp_sample;
+	status.requested_weight = _external_allocation_requested;
+	status.applied_weight = _external_allocation_weight.getState();
+	status.active = _external_allocation_active;
+	status.setpoint_valid = _external_allocation_setpoint_valid;
+	_external_allocation_status_pub.publish(status);
+
+	return status.applied_weight;
+}
